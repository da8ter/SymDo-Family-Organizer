{
    "elements": [
        {
            "type": "Label",
            "caption": "Pairs the SymDo smartphone app with this Symcon system. Devices connect via Symcon Connect using their own access token — no license credentials are stored in the app."
        },
        {
            "type": "Label",
            "name": "ConnectInfo",
            "caption": ""
        },
        {
            "type": "Button",
            "caption": "Pair new device",
            "onClick": "LAB_CreatePairing($id);"
        },
        {
            "type": "Image",
            "name": "PairingQrImage",
            "image": "",
            "visible": false
        },
        {
            "type": "Label",
            "name": "PairingCodeLabel",
            "caption": "",
            "visible": false
        },
        {
            "type": "ExpansionPanel",
            "caption": "Browser access (web app)",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Opens the SymDo app as a website over Symcon Connect — no app install needed. Create an access, then scan the QR code with the phone camera; the browser opens the app already paired. The one-time code is valid for 10 minutes; the browser then keeps its own access token."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "LocalHttpsUrl",
                    "caption": "Local HTTPS URL (optional, e.g. https://symcon.mydomain.de) — on the home network the web app switches to this local address; Symcon Connect stays the fallback when away. Requires a browser-trusted certificate."
                },
                {
                    "type": "Button",
                    "caption": "Create browser access",
                    "onClick": "LAB_CreateWebAccess($id);"
                },
                {
                    "type": "Image",
                    "name": "WebAccessQrImage",
                    "image": "",
                    "visible": false
                },
                {
                    "type": "Label",
                    "name": "WebAccessLabel",
                    "caption": "",
                    "visible": false
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "AI Photo Analysis → Extracts tasks from documents",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Photograph documents and let AI turn them into to-do tasks — e.g. notices from school, daycare or the sports club, parent letters, letters from authorities or the doctor, appointment slips, invitations. Saves tedious retyping. The photo goes from the browser to this bridge, which forwards it to the chosen AI; the API key stays here on the server."
                },
                {
                    "type": "Select",
                    "name": "AiProvider",
                    "caption": "Provider",
                    "onChange": "LAB_UpdateAiFormVisibility($id, $AiProvider);",
                    "options": [
                        { "caption": "Anthropic (Claude)", "value": "anthropic" },
                        { "caption": "OpenAI (GPT)", "value": "openai" },
                        { "caption": "Local server (OpenAI-compatible)", "value": "local" }
                    ]
                },
                {
                    "type": "PasswordTextBox",
                    "name": "AiAnthropicKey",
                    "caption": "Anthropic API key (sk-ant-…)"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "AiOpenAIKey",
                    "caption": "OpenAI API key (sk-…)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "AiLocalBaseUrl",
                    "caption": "Local base URL (e.g. http://192.168.1.50:11434/v1)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "AiLocalModel",
                    "caption": "Local model (a vision model, e.g. llama3.2-vision)"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "AiLocalKey",
                    "caption": "Local API key (optional)"
                },
                {
                    "type": "Label",
                    "caption": "Note: this feature needs your own API key from the provider. Cloud providers (Anthropic/OpenAI) cost a few cents per scan and send the photo to their cloud; a local server keeps everything in your network but needs a vision-capable model. Create keys at console.anthropic.com / platform.openai.com. The key is stored in this instance's configuration on your server."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Users",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Household members for task assignment. The photo is a Symcon media object (image)."
                },
                {
                    "type": "List",
                    "name": "Users",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Name",
                            "name": "name",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Photo",
                            "name": "photo",
                            "width": "220px",
                            "add": 0,
                            "edit": {
                                "type": "SelectMedia"
                            }
                        },
                        {
                            "caption": "Push visualization",
                            "name": "visu",
                            "width": "220px",
                            "add": 0,
                            "edit": {
                                "type": "SelectInstance"
                            }
                        },
                        {
                            "caption": "ID",
                            "name": "id",
                            "width": "110px",
                            "add": ""
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Paired devices",
            "expanded": true,
            "items": [
                {
                    "type": "List",
                    "name": "PairedDevicesList",
                    "rowCount": 6,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "ID",
                            "name": "deviceId",
                            "width": "90px"
                        },
                        {
                            "caption": "Name",
                            "name": "deviceName",
                            "width": "auto"
                        },
                        {
                            "caption": "Model",
                            "name": "model",
                            "width": "140px"
                        },
                        {
                            "caption": "Platform",
                            "name": "platform",
                            "width": "100px"
                        },
                        {
                            "caption": "App version",
                            "name": "appVersion",
                            "width": "110px"
                        },
                        {
                            "caption": "Paired",
                            "name": "createdAt",
                            "width": "140px"
                        },
                        {
                            "caption": "Last seen",
                            "name": "lastSeenAt",
                            "width": "140px"
                        },
                        {
                            "caption": "Status",
                            "name": "status",
                            "width": "110px"
                        }
                    ],
                    "values": []
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Revoke selected device",
                            "onClick": "if (is_array($PairedDevicesList)) { LAB_RevokeDevice($id, (string)$PairedDevicesList['deviceId']); }"
                        },
                        {
                            "type": "Button",
                            "caption": "Remove revoked entries",
                            "onClick": "LAB_RemoveRevokedDevices($id);"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Only one SymDo Bridge instance is allowed per system."
        }
    ]
}